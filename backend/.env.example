# TORQ Backend Environment Configuration
PORT=5000
NODE_ENV=development

# MongoDB Atlas Connection String
# Replace <username>, <password>, and <cluster-url> with your MongoDB Atlas credentials:
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster-url>.mongodb.net/Torq?retryWrites=true&w=majority
DB_NAME=Torq

# Better Auth Secret (Min 32 characters)
BETTER_AUTH_SECRET=torq_luxury_motors_production_auth_super_secure_key_2026_x99
BETTER_AUTH_URL=http://localhost:5000

# Client Application URL
CLIENT_URL=http://localhost:3000
