{
  "name": "torq-workspace",
  "version": "1.0.0",
  "private": true,
  "description": "TORQ Luxury Motors - Full-Stack Monorepo with Next.js Frontend and Express/Better-Auth Backend",
  "scripts": {
    "dev:frontend": "npm run dev --prefix frontend",
    "dev:backend": "npm run dev --prefix backend",
    "build:frontend": "npm run build --prefix frontend",
    "start:backend": "npm run start --prefix backend",
    "seed": "node --prefix backend -e \"fetch('http://localhost:5000/api/seed?force=true').then(r=>r.json()).then(console.log)\""
  },
  "keywords": [
    "nextjs",
    "express",
    "better-auth",
    "mongodb",
    "car-hire",
    "luxury-motors"
  ],
